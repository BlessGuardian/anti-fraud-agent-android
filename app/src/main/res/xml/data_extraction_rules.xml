<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup automatico (Android 12+; minSdk 31, entao backup_rules.xml nao e usado).

   Vai para o backup e volta ao reinstalar ou trocar de celular:
   - sharedpref: device_id (mantem o historico do DynamoDB) e configuracoes do Perfil;
   - database: contatos confiaveis e historico de ligacoes.

   A fila PENDING fica no mesmo banco, mas NAO e reenviada: na primeira execucao de cada
   instalacao (marcador em noBackupFilesDir) o MessageRepository descarta os PENDING restaurados,
   que ja tinham sido enviados pelo aparelho antigo e duplicariam registros no DynamoDB.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
